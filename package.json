{
  "name": "pixelator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-contained pixel-art studio — Generate / Pixelate / Animate on Retro Diffusion (via Replicate). Internal tool.",
  "scripts": {
    "dev": "concurrently -n vite,proxy -c green,yellow \"vite\" \"node server/index.mjs\"",
    "web": "vite",
    "proxy": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "gifenc": "^1.0.3",
    "pixi.js": "^8.6.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.0",
    "express": "^5.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
