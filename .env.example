# Pixelator — internal tool. Copy to `.env` and fill in.
# Provider is the Retro Diffusion DIRECT API (rdpk- key). Without a key the app runs in
# MOCK mode (procedural sprites) so the whole UI is usable offline.

# Retro Diffusion API key (https://retrodiffusion.ai/app/settings) — powers generate / animate / tiles
RETRO_DIFFUSION_API_KEY=

# Which engine handles /api/animate: "retrodiffusion" (default) or "pixellab" (optional fast alt)
ANIMATE_PROVIDER=retrodiffusion

# Optional: PixelLab token, only used when ANIMATE_PROVIDER=pixellab
PIXELLAB_API_TOKEN=

PORT=8787
